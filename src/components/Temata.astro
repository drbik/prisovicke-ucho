---
// Feed vedle ucha (13. 11. 2026, Tomáš): jednoduchý seznam vzkazů a dotazů s filtry stavu a typu nahoře.
// Uložené vzkazy se ukazují hned, bez schválení, od nejnovějšího. Za nimi jsou ukázkové dotazy se štítkem Ukázka.
// Data jdou do stránky jako JSON, seznam staví skript src/skripty/temata.ts.
import { TYPY_PODNETU } from '../lib/oblasti';
import { uloziste } from '../lib/prostredi';
import { POCET_VE_FEEDU, feedDoStranky, sestavitFeed } from '../lib/vzkazy/feed';
import type { PolozkaFeedu } from '../lib/vzkazy/typy';

let ulozene: PolozkaFeedu[] = [];
try {
  ulozene = await uloziste.feed(POCET_VE_FEEDU);
} catch (chyba) {
  // Výpadek databáze feed nezastaví, ukážou se aspoň ukázky.
  console.error({ udalost: 'feed-selhal', hlaska: chyba instanceof Error ? chyba.message.slice(0, 200) : 'neznámá chyba' });
}
const polozky = sestavitFeed(ulozene);

const TYPY_MNOZNE: Record<keyof typeof TYPY_PODNETU, string> = {
  dotaz: 'Dotazy',
  navrh: 'Návrhy',
  stiznost: 'Stížnosti',
  pochvala: 'Pochvaly',
};
---

<section class="feed" aria-labelledby="feed-titulek" data-feed>
  <header class="feed__hlavicka">
    <h2 id="feed-titulek">Vzkazy a dotazy</h2>
    <label class="jen-ctecka" for="feed-hledat">Hledat ve vzkazech a odpovědích</label>
    <input id="feed-hledat" class="feed__hledat" type="search" placeholder="Hledat" autocomplete="off" data-feed-hledat />
  </header>
  <!-- Zkušební provoz heslovitě (Tomáš 13. 11. 2026): ukázky nejsou dotazy občanů ani týmu. -->
  <p class="feed__zkusebni">Zkušební provoz · ukázkové dotazy a odpovědi · vzkazy se zveřejňují bez jména · nejde o úřední vyjádření obce</p>

  <div class="feed__filtry">
    <div class="feed__filtr" role="group" aria-label="Stav">
      <button type="button" class="filtr" aria-pressed="true" data-filtr="stav" data-hodnota="">Vše <span class="filtr__pocet" data-feed-pocet=""></span></button>
      <button type="button" class="filtr" aria-pressed="false" data-filtr="stav" data-hodnota="zodpovezeno">Zodpovězené <span class="filtr__pocet" data-feed-pocet="zodpovezeno"></span></button>
      <button type="button" class="filtr" aria-pressed="false" data-filtr="stav" data-hodnota="ceka">Čekají na odpověď <span class="filtr__pocet" data-feed-pocet="ceka"></span></button>
    </div>
    <div class="feed__filtr" role="group" aria-label="Typ">
      <button type="button" class="filtr filtr--typ" aria-pressed="true" data-filtr="typ" data-hodnota="">Všechny typy</button>
      {Object.entries(TYPY_MNOZNE).map(([typ, nazev]) => (
        <button type="button" class="filtr filtr--typ" aria-pressed="false" data-filtr="typ" data-hodnota={typ}>{nazev}</button>
      ))}
    </div>
  </div>

  <ul class="feed__seznam" data-feed-seznam></ul>
  <p class="feed__nic" data-feed-nic hidden>Tady nic není.</p>
  <noscript><p class="feed__nic">Seznam vzkazů potřebuje JavaScript.</p></noscript>
  <script type="application/json" id="feed-data" set:html={feedDoStranky(polozky)}></script>
</section>

<script src="../skripty/temata.ts"></script>
