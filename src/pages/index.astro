---
import Podani from '../components/Podani.astro';
import Temata from '../components/Temata.astro';
import Zaklad from '../layouts/Zaklad.astro';
---

<Zaklad
  titulek="Příšovické ucho"
  popis="Namluvte nebo napište návrh či dotaz k dění v Příšovicích. Zkušební provoz."
>
  <main class="stranka stranka--prehled">
    <a class="zpet" href="/" target="_top">← Na web Nezávislých pro Příšovice</a>
    <article class="karta prehled__ucho">
      <p class="nadtitulek">Nezávislí pro Příšovice</p>
      <h1>Příšovické ucho</h1>
      <p class="uvod">Máte návrh nebo dotaz k dění v obci? Řekněte ho vlastními slovy a my ho převedeme na text.</p>
      <Podani />
    </article>
    <div class="prehled__temata">
      <Temata />
    </div>
    <footer class="prehled__paticka">
      <aside class="poznamka">
        <p><strong>Zkušební provoz.</strong> Upravený vzkaz si můžete opravit a potvrdit, zatím se ale nikam neuloží a nikdo ho nedostane. Na dotaz zkusíme najít odpověď na webu obce a na webu Nezávislých pro Příšovice.</p>
      </aside>
      <p class="drobne">K přepisu, úpravě textu a hledání odpovědí používáme Workers AI od Cloudflare. Nahrávku neukládáme. Ucho není úředním kanálem obce a jeho odpovědi nejsou úředním vyjádřením obce.</p>
    </footer>
  </main>
</Zaklad>
